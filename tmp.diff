@@ -18,9 +29,25 @@
     ];
   };
 
+  # nixos-rebuild on the controller evaluates the node configs itself, so it
+  # needs a nixpkgs to resolve <nixpkgs> against and the controller user has to
+  # be trusted to push closures around
+  nix.nixPath = [ "nixpkgs=${pkgs.path}" ];
+  nix.settings.trusted-users = [
+    "root"
+    "controller"
+  ];
+
   systemd.tmpfiles.rules = [
-    "d /home/controller/.cache 0755 controller users -"
-    "d /home/controller/.config 0755 controller users -"
+    "d ${home}/.cache 0755 controller users -"
+    "d ${home}/.config 0755 controller users -"
+
+    # copy the fleet configurations onto the controller so ndeploy can deploy
+    # them, C copies recursively and leaves existing copies alone
+    "d ${configDir} 0755 controller users -"
+    "C ${configDir}/controller 0755 controller users - ${./.}"
+    "C ${configDir}/node 0755 controller users - ${../nodet1}"
+    "Z ${configDir} - controller users -"
   ];
 
